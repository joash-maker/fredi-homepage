{
  "rewrites": [
    {
      "source": "/calculator",
      "destination": "/calculator.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fredi-homepage.vercel.app"
        }
      ],
      "destination": "https://fredi.mediahubink.com/:path*",
      "permanent": true
    },
    {
      "source": "/fredi-homepage-final/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-fredi.html",
      "destination": "https://www.mediahubink.com/privacy",
      "permanent": true
    }
  ]
}
